<?xml version="1.0"?>
<Containers>
  <Container>
    <Name>filament-manager</Name>
    <Repository>filament-manager</Repository>
    <Registry/>
    <Network>bridge</Network>
    <MyIP/>
    <Shell>sh</Shell>
    <Privileged>false</Privileged>
    <Support/>
    <Project>https://github.com/oliverzein/filament-manager</Project>
    <Overview>Web app to manage 3D-printing filament profiles and spool inventory, with sync to a Creality K2 printer DB and OrcaSlicer presets. Built and loaded locally via scripts/release.sh + scripts/deploy-unraid.sh.</Overview>
    <Category>HomeAutomation:</Category>
    <WebUI>http://[IP]:[PORT:8404]/</WebUI>
    <TemplateURL/>
    <Icon/>
    <ExtraParams/>
    <PostArgs/>
    <Date>2026-08-26</Date>
    <Config Name="HTTP port" Target="8000" Default="8404" Mode="tcp" Description="Container port 8000 mapped to host port 8404." Type="Port" Display="always" Required="true" Mask="false"/>
    <Config Name="App data" Target="/data" Default="/mnt/user/appdata/filament-manager" Mode="rw" Description="Bind-mounted app data directory holding the SQLite database (filaments.db)." Type="Path" Display="always" Required="true" Mask="false"/>
    <Config Name="FM_DATABASE_URL" Target="FM_DATABASE_URL" Default="sqlite:////data/filaments.db" Mode="" Description="SQLAlchemy database URL (sqlite:////data/filaments.db — absolute path inside the container). Points at the bind-mounted volume." Type="Variable" Display="always" Required="true" Mask="false"/>
    <Config Name="FM_PRINTER_IP" Target="FM_PRINTER_IP" Default="192.168.0.101" Mode="" Description="Creality K2 printer IP for sync." Type="Variable" Display="always" Required="true" Mask="false"/>
    <Config Name="FM_SSH_USER" Target="FM_SSH_USER" Default="root" Mode="" Description="SSH user for the printer." Type="Variable" Display="always" Required="true" Mask="false"/>
    <Config Name="FM_SSH_PASSWORD" Target="FM_SSH_PASSWORD" Default="" Mode="" Description="SSH password for the printer." Type="Variable" Display="always" Required="true" Mask="true"/>
    <Config Name="FM_DB_REMOTE_PATH" Target="FM_DB_REMOTE_PATH" Default="/mnt/UDISK/creality/userdata/box/material_database.json" Mode="" Description="Remote printer DB path." Type="Variable" Display="advanced" Required="true" Mask="false"/>
    <Config Name="FM_WS_PORT" Target="FM_WS_PORT" Default="9999" Mode="" Description="Printer websocket port." Type="Variable" Display="advanced" Required="false" Mask="false"/>
    <Config Name="FM_VERSION_OVERRIDE" Target="FM_VERSION_OVERRIDE" Default="9876543210" Mode="" Description="Printer DB version override (must be &gt;= 9876543210)." Type="Variable" Display="advanced" Required="false" Mask="false"/>
    <Config Name="FM_ID_RANGE_START" Target="FM_ID_RANGE_START" Default="99001" Mode="" Description="Start of custom printer ID range (99xxx)." Type="Variable" Display="advanced" Required="false" Mask="false"/>
    <Config Name="FM_AGENT_TOKEN" Target="FM_AGENT_TOKEN" Default="CHANGE_ME" Mode="" Description="Shared token authenticating the fm-agent CLI." Type="Variable" Display="always" Required="true" Mask="true"/>
  </Container>
</Containers>
